# 複製成 .env 後填入自己的值；.env 不要提交到 Git

# 樂天市場 API
RAKUTEN_APPLICATION_ID=your_rakuten_application_id
RAKUTEN_ACCESS_KEY=your_rakuten_access_key

# 不用 Docker、直接在本機執行時使用的 MySQL 設定
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ichiban_price_monitor

# 用 Docker Compose 啟動時，容器內 MySQL 的帳號密碼（可自訂）
MYSQL_ROOT_PASSWORD=change_me_root
COMPOSE_DB_USER=ichiban
COMPOSE_DB_PASSWORD=change_me
